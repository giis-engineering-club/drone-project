# KiCad lock files (created while files are open)
*.lck

# KiCad backup files
*.bak

# KiCad autosave / recovery files
*.kicad_sch-bak
*.kicad_pcb-bak

# Temporary files
*~
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# KiCad local user settings
*.kicad_prl

# Local cache / generated files
fp-info-cache